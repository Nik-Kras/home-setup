{
  "expo": {
    "name": "Moved In",
    "slug": "home-setup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.homesetup.household",
      "deploymentTarget": "17.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E1110",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "app.homesetup.household"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/instrument-serif/400Regular/InstrumentSerif_400Regular.ttf",
            "./node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
            "./node_modules/@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "OurFlatSmall",
              "label": "Moved In \u00b7 small",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "OurFlatMedium",
              "label": "Moved In \u00b7 medium",
              "minWidth": "260dp",
              "minHeight": "164dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "OurFlatLarge",
              "label": "Moved In \u00b7 large",
              "minWidth": "260dp",
              "minHeight": "304dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.homesetup.household.ExpoWidgetsTarget",
          "groupIdentifier": "group.app.homesetup.household",
          "widgets": [
            {
              "name": "OurFlat",
              "displayName": "Moved In",
              "description": "What is left to get for the flat",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "./src/components/widgets/OurFlatIosWidget.tsx"
              },
              "android": null
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Moved In to take item photos.",
          "photosPermission": "Allow Moved In to choose item photos from your library.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-release-signing",
      "./plugins/with-early-intent"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/6f58cb80-e4e4-4144-9af0-c97c60bdd8eb",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "scheme": "homesetup",
    "backgroundColor": "#0E1110",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "app.homesetup.household.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.homesetup.household"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "6f58cb80-e4e4-4144-9af0-c97c60bdd8eb"
      }
    },
    "owner": "nikitakras"
  }
}
