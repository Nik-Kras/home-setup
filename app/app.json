{
  "expo": {
    "name": "Home Setup",
    "slug": "home-setup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.homesetup.household"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.homesetup.household"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Home Setup to take item photos.",
          "photosPermission": "Allow Home Setup to choose item photos from your library.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "homesetup",
    "backgroundColor": "#0E1110"
  }
}